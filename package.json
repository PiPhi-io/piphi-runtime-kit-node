{
  "name": "piphi-runtime-kit-node",
  "version": "0.1.3",
  "description": "PiPhi Network runtime integration helpers for Node.js",
  "keywords": [
    "piphi",
    "runtime",
    "integration",
    "iot",
    "node"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "test:watch": "node --test --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/PiPhi-io/piphi-runtime-kit-node#readme",
  "bugs": {
    "url": "https://github.com/PiPhi-io/piphi-runtime-kit-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiPhi-io/piphi-runtime-kit-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "PiPhi Network",
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
